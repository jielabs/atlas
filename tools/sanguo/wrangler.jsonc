// The stand-alone atlas site on Cloudflare Workers static assets: no Worker code, only the files built by
//   python3 tools/sanguo/build_site.py --pages
// (the --pages flag adds the _headers file Cloudflare reads for caching and types). Deploy with
//   npx wrangler deploy --config tools/sanguo/wrangler.jsonc
{
  "name": "atlas",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../../dist/atlas"
  },
  "workers_dev": false,
  // Cloudflare creates and keeps the DNS record for a Workers custom domain.
  "routes": [{ "pattern": "sanguo.yangjie.org", "custom_domain": true }]
}
